import { App, MarkdownView } from 'obsidian';
import { TextCounter } from '../utils/text-counter';
import { NovelDashboardData } from './saved-data';

export class WritingSession {
	app: App;

	data: NovelDashboardData;

	timer: number | null = null;

	lastTypingTime = 0;

	constructor(app: App, data: NovelDashboardData) {
		this.app = app;

		this.data = data;
	}

	start() {
		this.app.workspace.containerEl.addEventListener(
			'keydown',
			this.handleKeyDown,
		);

		this.app.workspace.containerEl.addEventListener(
			'compositionend',
			this.handleCompositionEnd,
		);

		console.log('Writing session started');
	}

	stop() {
		this.app.workspace.containerEl.removeEventListener(
			'keydown',
			this.handleKeyDown,
		);

		this.app.workspace.containerEl.removeEventListener(
			'compositionend',
			this.handleCompositionEnd,
		);

		if (this.timer) {
			window.clearInterval(this.timer);
		}
	}

	handleKeyDown = (event: KeyboardEvent) => {
		const view = this.app.workspace.getActiveViewOfType(MarkdownView);

		// 当前不是编辑 Markdown

		if (!view) {
			return;
		}

		const file = view.file;

		if (!file) {
			return;
		}

		// 只统计写作文件夹

		if (!file.path.startsWith(this.data.settings.writingFolder + '/')) {
			return;
		}

		/*
			过滤快捷键

			Ctrl+C
			Ctrl+V
			Ctrl+Z
			Ctrl+A

		*/

		if (event.ctrlKey || event.metaKey) {
			return;
		}

		// Alt 组合键

		if (event.altKey) {
			return;
		}

		/*
			删除

		*/

		if (event.key === 'Backspace' || event.key === 'Delete') {
			// 删除不计入每日写作统计

			return;
		}

		/*
			过滤功能键

		*/

		const ignoredKeys = [
			'Enter',

			'Tab',

			'Escape',

			'ArrowUp',

			'ArrowDown',

			'ArrowLeft',

			'ArrowRight',

			'Shift',

			'Control',

			'Alt',
		];

		if (ignoredKeys.includes(event.key)) {
			return;
		}

		/*
			只接受真实字符

		*/

		if (event.key.length !== 1) {
			return;
		}

		if (!TextCounter.isValidCharacter(event.key)) {
			return;
		}

		// 过滤空白字符

		// if (/\s/.test(event.key)) {
		// 	return;
		// }

		// 每日写作统计增加

		this.addWritingWords(1);
	};

	handleCompositionEnd = (event: CompositionEvent) => {
		const view = this.app.workspace.getActiveViewOfType(MarkdownView);

		if (!view) {
			return;
		}

		const file = view.file;

		if (!file) {
			return;
		}

		if (!file.path.startsWith(this.data.settings.writingFolder + '/')) {
			return;
		}

		const text = TextCounter.count(event.data);

		if (!text) {
			return;
		}

		// 每日写作统计增加

		if (text > 0) {
			this.addWritingWords(text);
		}
	};

	/**
	 * 每日写作统计
	 *
	 * 只记录新增字数
	 * 不接受负数
	 */

	addWritingWords(count: number) {
		if (count <= 0) {
			return;
		}

		const today = this.getToday();

		if (!this.data.dailyStats[today]) {
			this.data.dailyStats[today] = {
				words: 0,

				duration: 0,
			};
		}

		this.data.dailyStats[today]!.words += count;

		this.lastTypingTime = Date.now();

		this.startTimer();

		console.log('Writing added:', count);
	}

	startTimer() {
		if (this.timer) {
			return;
		}

		this.timer = window.setInterval(() => {
			if (Date.now() - this.lastTypingTime < 30000) {
				const today = this.getToday();

				const stat = this.data.dailyStats[today];

				if (stat) {
					stat.duration += 1;
				}
			}
		}, 1000);
	}

	getToday() {
		const date = new Date();

		return [
			date.getFullYear(),

			String(date.getMonth() + 1).padStart(2, '0'),

			String(date.getDate()).padStart(2, '0'),
		].join('-');
	}
}
